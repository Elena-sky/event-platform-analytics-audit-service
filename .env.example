# Copy to ``.env`` and adjust. All variables are required; the app has no in-code defaults.

APP_NAME=analytics-audit-service
APP_ENV=dev
APP_PORT=8010
LOG_LEVEL=INFO

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

RABBITMQ_EVENTS_EXCHANGE=events.topic
# Durable queue name for this consumer
RABBITMQ_QUEUE=analytics.events
# Comma-separated AMQP binding keys. Use # to receive every event.
RABBITMQ_BINDING_KEYS=#
RABBITMQ_PREFETCH=20

# Append-only audit log (JSON Lines format)
AUDIT_LOG_PATH=./data/audit-events.jsonl

# Docker Compose only: must match EVENT_PLATFORM_NETWORK_NAME in event-platform-infra .env
EVENT_PLATFORM_NETWORK_NAME=event-platform-net
