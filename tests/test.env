# Test-only env (committed). Loaded by tests/conftest.py before importing the app.
APP_NAME=analytics-audit-service
APP_ENV=test
APP_PORT=8010
LOG_LEVEL=INFO

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=test
RABBITMQ_PASSWORD=test

RABBITMQ_EVENTS_EXCHANGE=events.topic
RABBITMQ_QUEUE=analytics.events
RABBITMQ_BINDING_KEYS=#
RABBITMQ_PREFETCH=20

AUDIT_LOG_PATH=/tmp/test-audit-events.jsonl

REDIS_HOST=localhost
REDIS_PORT=6379
IDEMPOTENCY_TTL_SECONDS=86400
